PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://mentora:mentora@localhost:5432/mentora?schema=public"
CLIENT_URL="http://localhost:5173"
SUPABASE_URL="replace-with-your-supabase-project-url"
SUPABASE_ANON_KEY="replace-with-your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key"
PAYSTACK_SECRET_KEY="replace-with-a-paystack-secret-key"

# Transactional email is sent via the Gmail API using OAuth2 (a Google Cloud OAuth client with
# Gmail API enabled, reusing the same client used for "Sign in with Google"). All four are
# required for signup OTPs, password resets, and admin invites to actually send.
GOOGLE_OAUTH_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
GOOGLE_OAUTH_REFRESH_TOKEN="replace-with-a-refresh-token-for-the-sending-gmail-account"
GOOGLE_SENDER_EMAIL="replace-with-the-gmail-address-that-sends-mentora-email"

# Legacy — no longer used to send email (kept only as a documented fallback sender name).
BREVO_SMTP_LOGIN="replace-with-your-brevo-smtp-login"
BREVO_SMTP_KEY="replace-with-your-brevo-smtp-key"
BREVO_SENDER_EMAIL="helpdesk@mentora.dev"
BREVO_API_KEY="replace-with-your-brevo-api-key"

# Development seed commands only. Never reuse production credentials here.
SEED_TUTOR_PASSWORD="replace-with-a-development-only-password"
SEED_ADMIN_EMAIL="replace-with-a-development-admin-email"
SEED_ADMIN_PASSWORD="replace-with-a-development-only-password"
SEED_ADMIN_NAME="Mentora Admin"

# Optional: allows the tutor-seeding script to run outside production. Leave unset unless
# you're running that script locally.
ALLOW_DEMO_SEED="false"
